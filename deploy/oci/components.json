    {"paths": [".dockerignore", "deploy/oci/compose.yaml", "deploy/oci/components.json", "deploy/oci/affected.py", "deploy/oci/Go.Dockerfile", "deploy/oci/base-images.lock", ".github/workflows/build-images.yml"], "components": ["api", "worker", "scheduler", "video-worker", "operations", "admin", "dashboard", "capture", "onboarding", "keycloak"]}
