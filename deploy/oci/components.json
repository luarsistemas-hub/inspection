  "ignoredPaths": ["docs/", "deploy/docker-compose.yml", ".compozy/", ".github/", "deploy/oci/runtime/", "deploy/oci/foundation/", "deploy/oci/host/", "deploy/oci/tests/", "deploy/oci/ops.sh", "deploy/oci/verify-release.py", "deploy/oci/vault_secrets.py", "deploy/oci/affected.py", "deploy/oci/planner.py", "deploy/oci/compose.env.example", "deploy/oci/readme.md", "deploy/oci/secrets.map.example", "README.md", "LICENSE", ".gitignore"]
