# Public deployment settings; copy to /etc/inspection/public.env on the VM.
INSPECTION_DOMAIN=example.com
ADMIN_HOST=admin.example.com
DASHBOARD_HOST=dashboard.example.com
CAPTURE_HOST=capture.example.com
ONBOARDING_HOST=onboarding.example.com
API_HOST=api.example.com
AUTH_HOST=auth.example.com
STORAGE_HOST=storage.example.com
ADMIN_ORIGIN=https://admin.example.com
DASHBOARD_ORIGIN=https://dashboard.example.com
CAPTURE_ORIGIN=https://capture.example.com
ONBOARDING_ORIGIN=https://onboarding.example.com
API_ORIGIN=https://api.example.com
AUTH_ORIGIN=https://auth.example.com
STORAGE_ORIGIN=https://storage.example.com
OIDC_ISSUER=https://auth.example.com/realms/inspection
OIDC_JWKS_URL=https://auth.example.com/realms/inspection/protocol/openid-connect/certs
INSPECTION_ALLOWED_ORIGINS=https://admin.example.com,https://dashboard.example.com,https://capture.example.com,https://onboarding.example.com
OCI_REGION=replace-with-tenancy-home-region
OCI_S3_HOST=replace-with-namespace.compat.objectstorage.region.oraclecloud.com
OCI_S3_ENDPOINT=replace-with-namespace.compat.objectstorage.region.oraclecloud.com
OCI_S3_BUCKET=inspection-private
INSPECTION_NAMESPACE=replace-with-objectstorage-namespace
INSPECTION_COMPARTMENT_OCID=ocid1.compartment.oc1..replace
SUPER_ADMIN_SUBJECT=6ec9a740-a3dd-5ae5-ae50-9c29d189531b
TURNSTILE_SITE_KEY=replace-with-public-cloudflare-site-key
SMTP_ADDRESS=smtp.email.region.oci.oraclecloud.com:587
SMTP_FROM=approved-sender@example.com
RABBITMQ_USER=inspection-service
