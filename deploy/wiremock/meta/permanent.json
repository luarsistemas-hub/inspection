{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v[0-9.]+/[^/]+/messages",
    "headers": { "X-Simulator-Scenario": { "equalTo": "permanent" } }
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "error": { "code": "simulator_template_mismatch" } }
  }
}
