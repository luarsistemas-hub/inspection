{
  "persistent": false,
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.model",
          "matches": "gemini-(2\\.5|3\\.5|2\\.0)-flash-lite"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.metadata.comparison_mode",
          "equalTo": "TRANSCRIPTION"
        }
      },
      {
        "matchesJsonPath": "$.messages[1].content[?(@.type == 'input_audio')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "X-LiteLLM-Call-ID": "stub-transcription-no-speech",
      "X-LiteLLM-Response-Cost": "0.0001"
    },
    "jsonBody": {
      "id": "stub-transcription-no-speech",
      "provider": "stub",
      "model": "stub/gemini-audio",
      "choices": [
        {
          "message": {
            "content": "{\"transcript\":\"\",\"noSpeech\":true}"
          }
        }
      ],
      "usage": {
        "prompt_tokens": 20,
        "completion_tokens": 4,
        "prompt_tokens_details": {
          "audio_tokens": 8
        }
      },
      "cost": 0.0001
    }
  }
}
