# Public build-time settings for the Next.js browser application in host mode.
# Required consumer: browser bundle. Keep only public endpoints and client IDs;
# Compose injects the same browser-reachable URLs and must never use container-only hosts here.
# No credentials belong in this file.
# Required: GraphQL endpoint reachable from the browser, not from a container.
NEXT_PUBLIC_INSPECTION_API_URL=http://localhost:8080/graphql
# Required: Keycloak authorization endpoint used for PKCE navigation.
NEXT_PUBLIC_OIDC_AUTHORIZE_URL=http://localhost:8081/realms/inspection/protocol/openid-connect/auth
# Required: Keycloak token endpoint used only after validated PKCE callback.
NEXT_PUBLIC_OIDC_TOKEN_URL=http://localhost:8081/realms/inspection/protocol/openid-connect/token
# Required: public OIDC client ID; this is not a client secret.
NEXT_PUBLIC_OIDC_CLIENT_ID=inspection-web
