{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "es2022"], "strict": true,
    "noEmit": true, "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve",
    "incremental": true, "plugins": [{ "name": "next" }], "paths": { "@/*": ["./src/*"] },
    "allowJs": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
