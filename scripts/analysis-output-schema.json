    "findings"
  ],
  "properties": {
    "noRelevantChange": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "title",
          "description",
          "severity",
          "confidence",
          "evidenceIds",
          "quality",
          "recommendedAction"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "CONSERVATION",
              "INVENTORY",
              "CLEANLINESS",
              "OBSTRUCTION",
              "EVIDENCE_QUALITY"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "NONE",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
