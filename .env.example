# Shared host-mode configuration. Copy this file to `.env.inspection` before running Go
# processes on the host. Compose supplies equivalent internal service URLs.

# Required by inspection-migrate only: privileged database owner URL. Host port
# is 5433 to coexist with the retired POC; Compose uses postgres:5432 instead.
INSPECTION_MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/inspection?sslmode=disable
# Required by API, worker and scheduler: non-privileged runtime database URL.
INSPECTION_DATABASE_URL=postgres://inspection_runtime:inspection-runtime-local@localhost:5433/inspection?sslmode=disable
INSPECTION_DISPATCHER_DATABASE_URL=postgres://inspection_worker:inspection-worker-local@localhost:5433/inspection?sslmode=disable
# Required by the API to reject an accidental privileged runtime connection.
INSPECTION_RUNTIME_DB_ROLE=inspection_runtime

# Required by the API: explicit browser origin; wildcards are forbidden.
INSPECTION_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
# Required by host API only; Compose binds this same port from inside its network.
INSPECTION_HTTP_ADDR=:8080
INSPECTION_API_PORT=8080
INSPECTION_ADMIN_PORT=3000
INSPECTION_DASHBOARD_PORT=3002
INSPECTION_CAPTURE_PORT=3003
INSPECTION_MAILPIT_SMTP_PORT=1026
INSPECTION_MAILPIT_UI_PORT=8026
INSPECTION_TWILIO_FAKE_PORT=1081
INSPECTION_META_FAKE_PORT=1082
# Public capture application base URL used only when the worker renders an
# encrypted execution payload. It must be one of INSPECTION_ALLOWED_ORIGINS.
INSPECTION_CAPTURE_ORIGIN=http://localhost:3003
INSPECTION_WORKER_PORT=8082
INSPECTION_SCHEDULER_PORT=8083
# Required by every inspection process; use `test` only for isolated test auth.
INSPECTION_ENV=local
# Required by API OIDC verification; the browser-visible Keycloak issuer.
INSPECTION_OIDC_ISSUER=http://localhost:8081/realms/inspection
# Required by API OIDC verification; matches the public web client ID.
INSPECTION_OIDC_AUDIENCES=inspection-admin,inspection-dashboard
# Optional only for Compose: preserve the browser-visible issuer while the API
# fetches Keycloak signing keys through its private network address. Leave empty
# if issuer discovery is directly reachable by this process.
# INSPECTION_OIDC_JWKS_URL=http://keycloak:8080/realms/inspection/protocol/openid-connect/certs

# Required secret-backed Keycloak bootstrap identity. Set values only in the
# ignored .env.inspection file or the deployment secret manager.
# KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=
# KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
# INSPECTION_SUPER_ADMIN_USERNAME=
INSPECTION_SUPER_ADMIN_SUBJECT=6ec9a740-a3dd-5ae5-ae50-9c29d189531b
# INSPECTION_SUPER_ADMIN_PASSWORD=
# INSPECTION_SUPER_ADMIN_ISSUER=http://localhost:8081/realms/inspection

# Required by media adapters: keep storage private. Host port is 9002; Compose uses minio:9000.
INSPECTION_STORAGE_PUBLIC=false
INSPECTION_MINIO_ENDPOINT=localhost:9002
# Development-only MinIO principal, consumed by API and workers; replace outside local use.
INSPECTION_MINIO_ACCESS_KEY=inspection
INSPECTION_MINIO_SECRET_KEY=inspection-local-secret
INSPECTION_MINIO_BUCKET=inspection-private
INSPECTION_MINIO_SECURE=false

# Required infrastructure adapters. Host ports below intentionally differ from legacy POC ports;
# Compose consumers use rabbitmq, redis, mailpit and twilio-fake hostnames instead.
INSPECTION_RABBITMQ_URL=amqp://inspection:inspection@localhost:5673/
INSPECTION_DRAGONFLY_ADDRESS=localhost:6380
INSPECTION_SMTP_ADDRESS=localhost:1026
INSPECTION_SMTP_FROM=inspection@localhost
# INSPECTION_SMTP_USERNAME=
# INSPECTION_SMTP_PASSWORD=
# INSPECTION_SMTP_REPLY_TO=
INSPECTION_TWILIO_BASE_URL=http://localhost:1081
INSPECTION_TWILIO_ACCOUNT_SID=AC-local
INSPECTION_TWILIO_AUTH_TOKEN=local-token
INSPECTION_TWILIO_FROM=+15550000000
# Compose derives the callback host port from INSPECTION_API_PORT when unset.
# INSPECTION_TWILIO_CALLBACK_URL=http://localhost:8080/webhooks/twilio/status
# Deterministic LiteLLM is for local/test workers; production must configure its approved endpoint.
INSPECTION_LITELLM_URL=http://localhost:18080
INSPECTION_LITELLM_MODEL_ALIAS=inspection-vision
INSPECTION_LITELLM_PROMPT_VERSION=analysis-v1
# Real Gotenberg is used in Compose acceptance; this host URL exposes it on 3001.
INSPECTION_GOTENBERG_URL=http://localhost:3001
INSPECTION_PROVIDER_TIMEOUT=30s
# Operational notification service. Provider credentials and provider template
# IDs belong in ignored environment files or deployment secret management.
NOTIFICATION_MAX_ATTEMPTS=4
NOTIFICATION_RETRY_DELAYS=5s,30s,5m
# Enable only after compatible v1/v2 consumers are deployed.
NOTIFICATION_V2_PRODUCERS_ENABLED=true
SMTP_TLS_MODE=none
# TWILIO_SMS_FROM=+15550000000
# TWILIO_WHATSAPP_FROM=+15550000000
NOTIFICATION_WHATSAPP_PROVIDER=twilio
# TWILIO_TEMPLATE_MAP={"capture-link:v1:pt-BR":"content-sid"}
# META_BASE_URL=http://localhost:1082
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_API_VERSION=v22.0
# META_TEMPLATE_MAP={"capture-link:v1:pt-BR":"approved-template"}
# META_VERIFY_TOKEN=
# META_APP_SECRET=
# Required for operational capture and recapture links. This fixed local-only
# AES-256 key is not a production secret; replace it in ignored/deployment
# configuration with a key from the secret manager.
NOTIFICATION_PAYLOAD_KEYS={"local-v1":"MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="}
NOTIFICATION_ACTIVE_PAYLOAD_KEY=local-v1
# Required outside local mode; keep empty for local development.
# INSPECTION_METRICS_TOKEN=

# Live-provider smokes are disabled unless explicitly enabled. When enabled,
# every provider requires its own complete credentials, approved template and
# recipient; the recipient must also appear in the allowlist. Never use a
# production recipient in this file.
# INSPECTION_LIVE_SMOKES=false
# INSPECTION_LIVE_ALLOWLISTED_RECIPIENTS=
# INSPECTION_LIVE_TWILIO_BASE_URL=
# INSPECTION_LIVE_TWILIO_ACCOUNT_SID=
# INSPECTION_LIVE_TWILIO_AUTH_TOKEN=
# INSPECTION_LIVE_TWILIO_SMS_FROM=
# INSPECTION_LIVE_TWILIO_SMS_RECIPIENT=
# INSPECTION_LIVE_TWILIO_WHATSAPP_FROM=
# INSPECTION_LIVE_TWILIO_WHATSAPP_RECIPIENT=
# INSPECTION_LIVE_TWILIO_WHATSAPP_TEMPLATE=
# INSPECTION_LIVE_META_BASE_URL=
# INSPECTION_LIVE_META_ACCESS_TOKEN=
# INSPECTION_LIVE_META_PHONE_NUMBER_ID=
# INSPECTION_LIVE_META_API_VERSION=
# INSPECTION_LIVE_META_RECIPIENT=
# INSPECTION_LIVE_META_TEMPLATE=
# INSPECTION_LIVE_META_LANGUAGE=pt-BR
# INSPECTION_LIVE_SMTP_ADDRESS=
# INSPECTION_LIVE_SMTP_USERNAME=
# INSPECTION_LIVE_SMTP_PASSWORD=
# INSPECTION_LIVE_SMTP_FROM=
# INSPECTION_LIVE_SMTP_RECIPIENT=
# INSPECTION_LIVE_SMTP_TLS_MODE=

# Public build-time settings consumed only by Next.js in host mode; never add credentials here.
# Compose derives the GraphQL endpoint from INSPECTION_API_PORT when unset.
# NEXT_PUBLIC_INSPECTION_API_URL=http://localhost:8080/graphql
NEXT_PUBLIC_OIDC_AUTHORIZE_URL=http://localhost:8081/realms/inspection/protocol/openid-connect/auth
NEXT_PUBLIC_OIDC_TOKEN_URL=http://localhost:8081/realms/inspection/protocol/openid-connect/token
NEXT_PUBLIC_OIDC_CLIENT_ID=inspection-dashboard
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002
INSPECTION_ONBOARDING_PORT=3004
NEXT_PUBLIC_CAPTURE_URL=http://localhost:3003
