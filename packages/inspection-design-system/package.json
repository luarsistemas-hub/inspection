{
  "name": "@inspection/design-system",
  "version": "0.1.0",
  "description": "Shared accessible visual primitives for Inspection products.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-css.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "22.15.33",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.36.0",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.7"
  }
}
